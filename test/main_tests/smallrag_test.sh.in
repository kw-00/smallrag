#!/bin/sh

set -eu

smallrag="@BUILD_DIR@/bin/smallrag"

fail() {
    printf 'smallrag_test: %s\n' "$*" >&2
    exit 1
}

[ -x "$smallrag" ] || fail "executable not found: $smallrag"

test_dir=$("@SHUTILS_PATH@/tempdir.sh") || fail 'cannot create temporary directory'
server_pid=
watchdog_pid=
cleanup() {
    if [ -n "$watchdog_pid" ]; then
        kill "$watchdog_pid" 2> /dev/null || :
        wait "$watchdog_pid" 2> /dev/null || :
    fi
    if [ -n "$server_pid" ]; then
        kill "$server_pid" 2> /dev/null || :
        wait "$server_pid" 2> /dev/null || :
    fi
    rm -rf "$test_dir"
}
trap cleanup 0
trap 'exit 1' HUP INT TERM

help_output="$test_dir/help_output"
help_error="$test_dir/help_error"
"$smallrag" -h > "$help_output" 2> "$help_error" || fail 'help failed'
[ ! -s "$help_error" ] || fail 'help wrote to stderr'
for text in 'Usage:' '-h - print this help' '-m <model-path>' \
        '-d <source-text>' '-e <embeddings-path>' '-p <query-prefix>' '-P <chunk-prefix>' \
        '-t <n-tokenizer-threads>' \
        '-b <batch-size>' '-s <max-seq>' 'Default: 2048' 'comma-separated'; do
    grep -Fq -e "$text" "$help_output" || fail "help is missing: $text"
done
for option in c u; do
    if grep -Fq -e "-$option " "$help_output"; then
        fail "help still lists removed option -$option"
    fi
    if "$smallrag" "-$option" 128 -h > /dev/null 2>&1; then
        fail "removed option -$option unexpectedly succeeded"
    fi
done

"$smallrag" -m "$test_dir/missing_model" -d "$test_dir/missing_source" \
    -e "$test_dir/embeddings" -h > "$test_dir/help_after_options" 2> "$help_error" \
    || fail 'help after other options failed'
cmp -s "$help_output" "$test_dir/help_after_options" || fail 'help output changed after other options'
[ ! -s "$help_error" ] || fail 'help after other options wrote to stderr'
[ ! -e "$test_dir/embeddings" ] || fail 'help created embeddings'
"$smallrag" -m unused -d 'first,,second' -e '' -h > "$test_dir/help_after_lists" \
    2> "$help_error" || fail 'help with filename lists failed'
cmp -s "$help_output" "$test_dir/help_after_lists" || fail 'filename lists changed help output'
[ ! -s "$help_error" ] || fail 'help with filename lists wrote to stderr'

if "$smallrag" > /dev/null 2>&1; then
    fail 'missing required options unexpectedly succeeded'
fi
if "$smallrag" -z > /dev/null 2>&1; then
    fail 'unknown option unexpectedly succeeded'
fi

expect_invalid_batch() {
    value=$1
    expected=$2
    if "$smallrag" -m unused -d unused -e "$test_dir/invalid_embeddings" \
            -b "$value" > /dev/null 2> "$test_dir/invalid_batch_error"; then
        fail "invalid batch size unexpectedly succeeded: $value"
    fi
    grep -Fq -e "$expected" "$test_dir/invalid_batch_error" \
        || fail "unexpected error for batch size: $value"
}
expect_invalid_batch 0 'Batch and max sequence sizes must be positive'
expect_invalid_batch -1 'Invalid value for option -b'
expect_invalid_batch invalid 'Invalid value for option -b'
expect_invalid_batch 2147483648 'A batch or max sequence size is too large'

expect_invalid_filenames() {
    sources=$1
    embeddings=$2
    expected=$3
    if "$smallrag" -m unused -d "$sources" -e "$embeddings" < /dev/null \
            > /dev/null 2> "$test_dir/invalid_filenames_error"; then
        fail 'invalid filename lists unexpectedly succeeded'
    fi
    grep -Fq -e "$expected" "$test_dir/invalid_filenames_error" \
        || fail 'unexpected error for filename lists'
}
for value in '' ',first' 'first,' 'first,,second'; do
    expect_invalid_filenames "$value" "$test_dir/invalid_embeddings" 'empty filename'
    expect_invalid_filenames unused "$value" 'empty filename'
done
expect_invalid_filenames 'first,second' "$test_dir/invalid_embeddings" 'filename counts must match'
expect_invalid_filenames unused 'first,second' 'filename counts must match'
[ ! -e "$test_dir/invalid_embeddings" ] || fail 'invalid arguments created embeddings'

# Exercise JSON-lines requests with the first configured embedding model.
model_paths="@GGUF_MODEL_PATHS@"
model_path=${model_paths%%,*}
[ -f "$model_path" ] && [ -r "$model_path" ] || fail "configured model is not readable: $model_path"

io_source="$test_dir/io_source"
io_output="$test_dir/io_output"
io_error="$test_dir/io_error"
io_timeout="$test_dir/io_timeout"
io_fifo="$test_dir/io_fifo"
chunk_one='An apple is red.'
chunk_two='Snow covers a mountain.'
chunk_three=$(printf '%s\n%s' 'A sign says "hello" and has a \ character.' 'Another line.')
{
    printf '%s' "$chunk_one"
    printf '%b' '\0000'
    printf '%s' "$chunk_two"
    printf '%b' '\0000'
    printf '%s' "$chunk_three"
} > "$io_source"

fail_io() {
    printf 'smallrag_test: %s\n' "$*" >&2
    if [ -f "$io_error" ]; then
        tail -n 30 "$io_error" >&2 || :
    fi
    exit 1
}

wait_for_lines() {
    while :; do
        if [ -f "$io_output" ] && [ "$(wc -l < "$io_output")" -ge "$1" ]; then
            return
        fi
        [ ! -e "$io_timeout" ] || fail_io 'timed out waiting for a response'
        kill -0 "$server_pid" 2> /dev/null || fail_io 'server ended before responding'
        sleep 1
    done
}

mkfifo "$io_fifo"
"$smallrag" -m "$model_path" -d "$io_source" -e "$test_dir/io_embeddings" \
    -t 1 -b 128 -s 2 < "$io_fifo" > "$io_output" 2> "$io_error" &
server_pid=$!
(
    sleep 180 &
    timer_pid=$!
    trap 'kill "$timer_pid" 2> /dev/null || :; wait "$timer_pid" 2> /dev/null || :; exit 0' HUP INT TERM
    if wait "$timer_pid"; then
        : > "$io_timeout"
        kill "$server_pid" 2> /dev/null || :
    fi
) &
watchdog_pid=$!

exec 3> "$io_fifo"
printf '%s\n' '{"query":"An apple is red.","top_k":1}' >&3 || fail_io 'failed to send request'
wait_for_lines 1

# Invalid lines must not prevent the next valid request from receiving a response.
printf '%s\n' \
    '{"query":"An apple is red.","top_k":}' \
    '{"query":"An apple is red."}' \
    '{"query":"An apple is red.","top_k":0}' \
    '{"query":"An apple is red.","top_k":"three"}' \
    '{"query":"An apple is red.","top_k":3}' >&3 || fail_io 'failed to send requests'
wait_for_lines 2

printf '%s\n' \
    '{"query":"An apple is red.","top_k":2}' \
    '{"query":"An apple is red.","top_k":5}' \
    '{"query":"Snow covers a mountain.","top_k":1}' >&3 || fail_io 'failed to send requests'
exec 3>&-
if ! wait "$server_pid"; then
    server_pid=
    fail_io 'server failed during JSON-lines requests'
fi
server_pid=
kill "$watchdog_pid" 2> /dev/null || :
wait "$watchdog_pid" 2> /dev/null || :
watchdog_pid=

[ "$(wc -l < "$io_output")" -eq 5 ] || fail_io 'expected one output line per valid request'
grep -Fq -e 'Failed to parse JSON' "$io_error" || fail_io 'invalid JSON was not reported'
grep -Fq -e 'Request' "$io_error" || fail_io 'invalid requests were not reported'

# Ignore insignificant JSON whitespace, but preserve string contents and escapes.
normalized="$test_dir/io_normalized"
awk '
{
    quoted = 0
    escaped = 0
    for (i = 1; i <= length($0); i++) {
        character = substr($0, i, 1)
        if (quoted) {
            printf "%s", character
            if (escaped) {
                escaped = 0
            } else if (character == "\\") {
                escaped = 1
            } else if (character == "\"") {
                quoted = 0
            }
        } else if (character == "\"") {
            quoted = 1
            printf "%s", character
        } else if (character !~ /[[:space:]]/) {
            printf "%s", character
        }
    }
    printf "\n"
}' "$io_output" > "$normalized"

{
    IFS= read -r one_response || fail_io 'missing top_k=1 response'
    IFS= read -r full_response || fail_io 'missing top_k=3 response'
    IFS= read -r two_response || fail_io 'missing top_k=2 response'
    IFS= read -r capped_response || fail_io 'missing top_k=5 response'
    IFS= read -r other_response || fail_io 'missing second query response'
    if IFS= read -r extra_response; then
        fail_io 'unexpected extra response'
    fi
} < "$normalized"

json_one='"An apple is red."'
json_two='"Snow covers a mountain."'
json_three='"A sign says \"hello\" and has a \\ character.\nAnother line."'
case "$full_response" in
    "[$json_one,$json_two,$json_three]" | "[$json_one,$json_three,$json_two]" | \
    "[$json_two,$json_one,$json_three]" | "[$json_two,$json_three,$json_one]" | \
    "[$json_three,$json_one,$json_two]" | "[$json_three,$json_two,$json_one]") ;;
    *) fail_io "unexpected full response: $full_response" ;;
esac
# The fixture strings contain no commas, so these are the first one and two results.
[ "$one_response" = "${full_response%%,*}]" ] || fail_io 'top_k=1 does not match the first result'
[ "$two_response" = "${full_response%,*}]" ] || fail_io 'top_k=2 does not match the first two results'
[ "$capped_response" = "$full_response" ] || fail_io 'top_k larger than the corpus was not capped'
case "$other_response" in
    "[$json_one]" | "[$json_two]" | "[$json_three]") ;;
    *) fail_io "unexpected second query response: $other_response" ;;
esac

# Prefixing a chunk for embedding must not change the returned text.
single_source="$test_dir/single_source"
single_request="$test_dir/single_request"
printf '%s' "$chunk_one" > "$single_source"
printf '%s\n' '{"query":"An apple is red.","top_k":1}' > "$single_request"
"$smallrag" -m "$model_path" -d "$single_source" -e "$test_dir/single_embeddings" \
    -t 1 -b 128 -s 2 < "$single_request" > "$test_dir/single_output" 2> "$test_dir/single_error" \
    || fail 'unprefixed chunk test failed'
"$smallrag" -m "$model_path" -d "$single_source" -e "$test_dir/prefix_embeddings" \
    -P 'passage: ' -t 1 -b 128 -s 2 < "$single_request" > "$test_dir/prefix_output" \
    2> "$test_dir/prefix_error" || fail 'prefixed chunk test failed'
cmp -s "$test_dir/single_output" "$test_dir/prefix_output" || fail 'chunk prefix changed the response'
[ "$(cat "$test_dir/prefix_output")" = "[$json_one]" ] || fail 'unexpected prefixed chunk response'

# Split the same corpus across files, without delimiters at either side of the file boundary.
# Spaces in filenames must be preserved by the filename parser.
multi_source_one="$test_dir/multi source one"
multi_source_two="$test_dir/multi source two"
multi_embeddings_one="$test_dir/multi embeddings one"
multi_embeddings_two="$test_dir/multi embeddings two"
{
    printf '%s' "$chunk_one"
    printf '%b' '\0000'
    printf '%s' "$chunk_two"
} > "$multi_source_one"
printf '%s' "$chunk_three" > "$multi_source_two"
multi_requests="$test_dir/multi_requests"
printf '%s\n' \
    '{"query":"An apple is red.","top_k":5}' \
    '{"query":"An apple is red.","top_k":1}' \
    '{"query":"Snow covers a mountain.","top_k":1}' > "$multi_requests"
printf '%s\n' "$full_response" "$one_response" "$other_response" > "$test_dir/multi_expected"

"$smallrag" -m "$model_path" -d "$multi_source_one,$multi_source_two" \
    -e "$multi_embeddings_one,$multi_embeddings_two" -t 1 -b 128 -s 2 \
    < "$multi_requests" > "$test_dir/multi_output" 2> "$test_dir/multi_error" \
    || fail 'multiple-source embedding generation failed'
cmp -s "$test_dir/multi_expected" "$test_dir/multi_output" \
    || fail 'multiple-source retrieval differs from single-source retrieval'
[ -s "$multi_embeddings_one" ] && [ -s "$multi_embeddings_two" ] \
    || fail 'multiple-source embeddings were not created'
first_size=$(wc -c < "$multi_embeddings_one")
second_size=$(wc -c < "$multi_embeddings_two")
[ "$first_size" -eq "$((second_size * 2))" ] \
    || fail 'embedding files do not contain their own source chunks'
cp "$multi_embeddings_one" "$test_dir/multi_snapshot_one"
cp "$multi_embeddings_two" "$test_dir/multi_snapshot_two"

"$smallrag" -m "$model_path" -d "$multi_source_one,$multi_source_two" \
    -e "$multi_embeddings_one,$multi_embeddings_two" -t 1 -b 128 -s 2 \
    < "$multi_requests" > "$test_dir/multi_cached_output" 2> "$test_dir/multi_cached_error" \
    || fail 'multiple-source cached retrieval failed'
cmp -s "$test_dir/multi_output" "$test_dir/multi_cached_output" \
    || fail 'cached multiple-source retrieval changed'
cmp -s "$multi_embeddings_one" "$test_dir/multi_snapshot_one" \
    || fail 'cached first embeddings changed'
cmp -s "$multi_embeddings_two" "$test_dir/multi_snapshot_two" \
    || fail 'cached second embeddings changed'

multi_new_embeddings="$test_dir/multi_new_embeddings"
"$smallrag" -m "$model_path" -d "$multi_source_one,$multi_source_two" \
    -e "$multi_embeddings_one,$multi_new_embeddings" -t 1 -b 128 -s 2 \
    < "$multi_requests" > "$test_dir/multi_mixed_output" 2> "$test_dir/multi_mixed_error" \
    || fail 'mixed cached and new embeddings failed'
cmp -s "$test_dir/multi_output" "$test_dir/multi_mixed_output" \
    || fail 'mixed cached and new embeddings changed retrieval'
cmp -s "$multi_embeddings_one" "$test_dir/multi_snapshot_one" \
    || fail 'mixed embedding generation changed the existing file'
cmp -s "$multi_new_embeddings" "$test_dir/multi_snapshot_two" \
    || fail 'new embedding file does not contain its own source chunks'

printf '%s\n' '{"query":"An apple is red.","top_k":5}' > "$test_dir/multi_prefix_request"
"$smallrag" -m "$model_path" -d "$multi_source_one,$multi_source_two" \
    -e "$test_dir/multi_prefix_one,$test_dir/multi_prefix_two" -P 'passage: ' -p 'query: ' \
    -t 1 -b 128 -s 2 < "$test_dir/multi_prefix_request" > "$test_dir/multi_prefix_output" \
    2> "$test_dir/multi_prefix_error" || fail 'multiple-source prefixing failed'
case "$(cat "$test_dir/multi_prefix_output")" in
    "[$json_one,$json_two,$json_three]" | "[$json_one,$json_three,$json_two]" | \
    "[$json_two,$json_one,$json_three]" | "[$json_two,$json_three,$json_one]" | \
    "[$json_three,$json_one,$json_two]" | "[$json_three,$json_two,$json_one]") ;;
    *) fail 'prefixes changed multiple-source response text' ;;
esac

if "$smallrag" -m "$model_path" -d "$multi_source_one,$test_dir/missing_source" \
        -e "$test_dir/unused_one,$test_dir/unused_two" < /dev/null > /dev/null \
        2> "$test_dir/missing_source_error"; then
    fail 'missing second source unexpectedly succeeded'
fi
grep -Fq -e "Failed to map text: $test_dir/missing_source" "$test_dir/missing_source_error" \
    || fail 'missing second source was not reported'
[ ! -e "$test_dir/unused_one" ] && [ ! -e "$test_dir/unused_two" ] \
    || fail 'missing source created embedding files'

printf '%s' invalid > "$test_dir/invalid_second_embeddings"
if "$smallrag" -m "$model_path" -d "$multi_source_one,$multi_source_two" \
        -e "$multi_embeddings_one,$test_dir/invalid_second_embeddings" -t 1 -b 128 -s 2 \
        < /dev/null > /dev/null 2> "$test_dir/invalid_second_error"; then
    fail 'invalid second embedding file unexpectedly succeeded'
fi
grep -Fq -e 'Failed to load or compute embeddings' "$test_dir/invalid_second_error" \
    || fail 'invalid second embedding file was not reported'

# The first file is cached; embedding the second file exceeds this deliberately small batch.
if "$smallrag" -m "$model_path" -d "$multi_source_one,$multi_source_two" \
        -e "$multi_embeddings_one,$test_dir/failed_second_embeddings" -t 1 -b 8 -s 2 \
        < /dev/null > /dev/null 2> "$test_dir/failed_second_error"; then
    fail 'failed second embedding generation unexpectedly succeeded'
fi
grep -Fq -e 'Failed to get embeddings' "$test_dir/failed_second_error" \
    || fail 'embedding generation failure was not propagated'
[ ! -s "$test_dir/failed_second_embeddings" ] || fail 'failed generation wrote invalid embeddings'
cmp -s "$multi_embeddings_one" "$test_dir/multi_snapshot_one" \
    || fail 'failed loading changed the existing embedding file'

printf '%s\n' 'smallrag tests passed'
