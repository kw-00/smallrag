#!/bin/bash



USAGE=$(cat << EOF
Usage:
BUILD_DIR='build_dir_relative_to_module_root' \
    MODULE_NAME='module_name' \
    TARGET_TYPE='a_so_or_elf' \
    CC='compiler_program' \
    AR='archive_program' \
    [ CFLAGS='cflags_as_from_pkg-config' ] \
    [ LIBS='libs_as_from_pkg-config' ] \
    $? 

Run from module root. include/ and src/ folders are expected in module.
EOF
)

if [ -z "$BUILD_DIR" ]; then
    echo "BUILD_DIR required" >&2
    exit 1
fi
if [ -z "$MODULE_NAME" ]; then
    echo "MODULE_NAME required" >&2
    exit 1
fi
if [ -z "$TARGET_TYPE" ]; then
    echo "TARGET_TYPE required" >&2
    exit 1
fi
if [ -z "$CC" ]; then
    echo "CC required" >&2
    exit 1
fi
if [ -z "$AR" ]; then
    echo "AR required" >&2
    exit 1
fi

is_a=false
is_so=false
is_elf=false
if [ "$TARGET_TYPE" = "a" ]; then
    is_a=true
elif [ "$TARGET_TYPE" = "so" ]; then
    is_so=true
elif [ "$TARGET_TYPE" = "elf" ]; then
    is_elf=true
else
    echo "TARGET_TYPE must be one of a, so and elf" >&2
    exit 1
fi


headers=$(find include -type f -regex '.*\.h$' -exec printf '%s ' {} \;)
sources=$(find src -type f -regex '.*\.c$' -exec printf '%s ' {} \;) 

if [ -z "$sources" ]; then
    echo "Expected at least one .c source file in src/"
    exit 1
fi
if [ -z "$headers" ]; then
    echo "Expected at least one .h header file in include/"
    exit 1
fi

temp=tmp
mkdir "$temp"
sources_dir="$temp/sources"
objects_dir="$temp/objects"
mkdir "$sources_dir" "$objects_dir"
i=0
objects=
for source in $sources; do
    echo "$source" > "$sources_dir/$i"
    object="$BUILD_DIR/$MODULE_NAME/obj/${source%??}.o"
    echo "$object" > "$objects_dir/$i"
    objects+="$object "
    i=$((i + 1))
done
source_count=$i


target_path="$BUILD_DIR/$MODULE_NAME/lib/$MODULE_NAME.$TARGET_TYPE"

echo "all: $BUILD_DIR/$MODULE_NAME/lib/.stamp $BUILD_DIR/$MODULE_NAME/include/.stamp"
echo
echo "$BUILD_DIR/$MODULE_NAME/lib/.stamp: $target_path"
echo -e "\ttouch \$@"
echo
echo "$target_path: $objects"
if $is_a; then
    echo -e "\t$AR rcs \$@ \$^"
elif $is_so; then
    echo -e "\t$CC -shared -o \$@ \$^ $LIBS"
else
    # Executable
    echo -e "\t$CC -o \$@ \$^ $LIBS"
fi
echo
i=0
while [ $i -lt $source_count ]; do
    source=$(cat "$sources_dir/$i")
    object=$(cat "$objects_dir/$i")
    echo "$object: $source $headers"
    if $is_so; then
        echo -e "\t$CC -c -Iinclude $CFLAGS -fPIC -o \$@ $source"
    else
        echo -e "\t$CC -c -Iinclude $CFLAGS -o \$@ $source"
    fi
    i=$((i + 1))
done
echo
echo "$BUILD_DIR/$MODULE_NAME/include/.stamp: $headers"
echo -e "\tcp -R include/. $BUILD_DIR/$MODULE_NAME/include"
echo -e "\ttouch \$@"
echo

rm -rf "$temp"

